  m_Script: {fileID: 11500000, guid: 09d7c0aa79642e74b8a833dbc929cd72, type: 3}
  m_Name: GrandfatherDialogue_Default
  m_EditorClassIdentifier: 
  dialogueLines:
  - character:
      name: Nonno
      icon: {fileID: 0}
    lines:
    - Ciao Lorenzo, dimmi tutto?
    lineId: nonno_1
    questions:
    - question: Nonno, com'era la vita prima della guerra?
      responseId: nonno_response_1
    - question: Nonno, mi racconti qualcosa della tua storia? So che hai vissuto
        tanto, ma non ne parli mai...
      responseId: nonno_response_2
  - character:
      name: Nonno
      icon: {fileID: 0}
    lines:
    - Era semplice, Lorenzo.
    - Lavoravamo la terra, ci riunivamo la sera.
    - "Poi tutto \xE8 cambiato."
    lineId: nonno_response_1
    questions: []
  - character:
      name: Nonno
      icon: {fileID: 0}
    lines:
    - "Sai cosa? Hai ragione te ne parler\xF2."
    - Ma prima vai a prendermi i miei occhiali e mettili nella scatola.
    - Sono nel mio studio, li uso ancora per ricordare certe cose...
    lineId: nonno_response_2
    questions: []
